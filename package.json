    "test:smoke": "k6 run k6/smoke.test.js",
    "test:load": "k6 run k6/load.test.js",
    "test:stress": "k6 run k6/stress.test.js",
    "test:api": "k6 run k6/api.test.js",
    "test:load:staging": "k6 run -e K6_BASE_URL=https://sodoh.com k6/load.test.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "doppler": "^1.0.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.100.0"
